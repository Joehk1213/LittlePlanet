{
  "name": "littleplanet",
  "version": "1.0.0",
  "description": "LittlePlanet local backend project with Express and Supabase",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --exec \"node --dns-result-order=ipv4first\" index.js",
    "test": "node --test",
    "lint": "eslint \"src/**/*.js\" \"scripts/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-cache": "^5.1.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.10"
  }
}
