# Required application runtime settings.
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CORS: comma-separated exact origins, without paths. Leave empty for same-origin only.
CORS_ALLOWED_ORIGINS=

# General API limiter: requests per client IP per window.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120

# Generate unique random secrets of at least 32 characters for every token/key below.
CUSTOMER_LOOKUP_RATE_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CUSTOMER_SESSION_SECRET=replace-with-a-different-unique-customer-session-secret
SHIPPING_ADMIN_TOKEN=replace-with-a-unique-shipping-admin-token
INBOUND_ADMIN_TOKEN=replace-with-a-unique-inbound-admin-token
ANALYTICS_ADMIN_TOKEN=replace-with-a-unique-analytics-admin-token
ANALYTICS_PROFIT_DETAILS_ENABLED=false
PRODUCT_ADMIN_TOKEN=replace-with-a-unique-product-admin-token
REVIEWS_ADMIN_TOKEN=replace-with-a-unique-reviews-admin-token
REMINDER_CRON_TOKEN=replace-with-a-unique-reminder-cron-token
ADMIN_SESSION_SECRET=replace-with-a-unique-random-session-signing-secret-at-least-32-characters

# WhatsApp Cloud API; required only when WhatsApp notifications/webhooks are enabled.
WHATSAPP_GRAPH_API_VERSION=vXX.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_REMINDER_RECIPIENTS=85212345678,85298765432
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-unique-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Legacy alias accepted for existing deployments. Prefer WHATSAPP_API_TOKEN.
# WHATSAPP_ACCESS_TOKEN=
